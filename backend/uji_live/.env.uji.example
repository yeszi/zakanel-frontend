# =====================================================================
# KHUSUS PENGUJIAN LIVE  —  FILE INI TIDAK BOLEH DIBAGIKAN / DI-COMMIT
# Supabase, Infura, CONTRACT_ADDRESS, JWT_SECRET dibaca dari backend/.env
# =====================================================================

# Akun admin aplikasi yang sudah ada di Supabase
UJI_ADMIN_USERNAME=admin
UJI_ADMIN_PASSWORD=

# Private key wallet ADMIN = wallet yang dulu men-deploy smart contract
# (MetaMask > titik tiga akun > Account details > Show private key)
UJI_ADMIN_PRIVATE_KEY=

# Dua wallet BARU khusus uji (buat 2 akun baru di MetaMask), isi SepoliaETH
# dari faucet: penerbit1 >= 0.01, penerbit2 >= 0.003 SepoliaETH
UJI_PENERBIT1_PRIVATE_KEY=
UJI_PENERBIT2_PRIVATE_KEY=

# Opsional
# DATASET_PATH=C:\path\ke\data_sertifikat.xlsx   (kosong = 50 data sintetis)
# UJI_BENCH_N=20            jumlah pengulangan uji waktu respons
# UJI_WALLET_BENCH_N=3      jumlah tambah/cabut penerbit untuk uji waktu (tiap 1 = 2 transaksi)
# UJI_API_URL=https://api.domainanda.com   (kosong = backend dijalankan lokal tapi tetap pakai Supabase+Sepolia asli)
