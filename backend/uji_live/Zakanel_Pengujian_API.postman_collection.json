         "pm.test('Waktu respons tercatat', function () { pm.expect(pm.response.responseTime).to.be.a('number'); });",
         "var d=pm.response.json(); var l=(d.sertifikat||d.data||[]).filter(function(x){return x.status==='published';}); if(l.length && !pm.collectionVariables.get('public_id')){ pm.collectionVariables.set('public_id', l[0].public_id.replace(/-/g,'')); }"
