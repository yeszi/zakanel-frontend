     "name": "Login admin berhasil",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Login admin berhasil -> status 200', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
         "pm.test('Waktu respons tercatat', function () { pm.expect(pm.response.responseTime).to.be.a('number'); });",
         "var j=pm.response.json(); pm.collectionVariables.set('token_admin', j.token); pm.test('JWT diterbitkan', function(){ pm.expect(j.token.split('.').length).to.eql(3); });"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
